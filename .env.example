# Source this file only after copying to .env and filling in your values.
# Application code reads process environment variables, not .env files automatically.
DB_URL='jdbc:oracle:thin:@tcps://database.example.com:1521/service_name?connect_timeout=15sec&retry_count=0'
DB_USERNAME='FOUNDRY_RAG'
DB_PASSWORD=''
DEMO_API_TOKEN=''
FOUNDRY_ENDPOINT='https://your-resource.openai.azure.com'
FOUNDRY_CHAT_DEPLOYMENT='your-chat-deployment'
FOUNDRY_EMBEDDING_DEPLOYMENT='your-text-embedding-3-small-deployment'
EMBEDDING_DIMENSIONS=1536
# Leave blank to use DefaultAzureCredential (Azure CLI locally, managed identity in Azure).
FOUNDRY_API_KEY=''
# Opt in only on the first run, in a dedicated demo schema; existing tables are never dropped.
INITIALIZE_SCHEMA=false
# Agent Service configuration, independent of the RAG model endpoint.
FOUNDRY_PROJECT_ENDPOINT='https://your-resource.services.ai.azure.com/api/projects/your-project'
MCP_SERVER_URL='https://your-authenticated-mcp.example.com/mcp'
MCP_PROJECT_CONNECTION_NAME='oracle-document-mcp'
# Dedicated SELECT-only account for the existing Oracle MCP Toolkit.
MCP_DB_USERNAME='FOUNDRY_MCP_READ'
MCP_DB_PASSWORD=''
